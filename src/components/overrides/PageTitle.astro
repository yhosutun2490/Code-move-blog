---
// 標題上方標出系列位置，下方用導言樣式顯示簡介（Starlight 預設只放在 <meta>）
import Default from '@astrojs/starlight/components/PageTitle.astro'
import { getCollection } from 'astro:content'

const { entry } = Astro.locals.starlightRoute
const isPost = entry.id.startsWith('mobx/')
// 首頁（系列封面）也用這個標題區：上方是系列名，不是「第 0 篇」
const isHome = entry.id === ''
const total = isPost
  ? (await getCollection('docs', ({ id, data }) => id.startsWith('mobx/') && !data.draft)).length
  : 0
const { order, description } = entry.data
const eyebrow = isPost ? `MobX 拆解 · 第 ${order} 篇 / 共 ${total} 篇` : isHome ? '自我學習系列' : undefined
const lede = isPost || isHome ? description : undefined
---

{eyebrow && <p class="eyebrow">{eyebrow}</p>}
<Default />
{lede && <p class="lede">{lede}</p>}

<style>
  .eyebrow {
    font-family: var(--font-mono, var(--sl-font-mono));
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    color: var(--accent, var(--sl-color-accent));
    margin: 0 0 0.5rem;
  }

  .lede {
    color: var(--ink-soft, var(--sl-color-gray-2));
    font-size: var(--sl-text-lg);
    line-height: 1.7;
    margin: 0.75rem 0 0;
  }
</style>
