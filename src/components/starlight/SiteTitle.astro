---
// 頁首字標「前段/後段」：字樣來自網站設定，斜線用強調色，點了回首頁。
import { siteConfig } from '../../lib/site-config'

const { siteTitleHref } = Astro.locals.starlightRoute
const { before, after } = siteConfig.mark
---

<a href={siteTitleHref} class="site-mark" translate="no">{before}<span>/</span>{after}</a>

<style>
  .site-mark {
    font-family: var(--font-mono);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-mark span {
    color: var(--accent);
  }
</style>
