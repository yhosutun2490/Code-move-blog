---
// 文章頁的標題區：標題上方是「第 N 篇 / 共 M 篇」，下方是導言（frontmatter description）。
// 首頁也用 StarlightPage（entry.id 是 ''），那裡只顯示標題本身。
import Default from '@astrojs/starlight/components/PageTitle.astro'
import { getCollection } from 'astro:content'

const { entry } = Astro.locals.starlightRoute
const isPost = entry.id.startsWith('mobx/')
// production build 已排除草稿的頁面，但 getCollection 不會，所以 M 要自己濾掉草稿
const total = isPost
  ? (await getCollection('docs', ({ id, data }) => id.startsWith('mobx/') && !data.draft)).length
  : 0
---

{isPost && <p class="eyebrow">MobX 拆解 · 第 {entry.data.order} 篇 / 共 {total} 篇</p>}
<Default />
{isPost && <p class="lede">{entry.data.description}</p>}
