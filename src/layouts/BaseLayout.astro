---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'MobX 拆解筆記：從 getter/setter 一路到 observer' } = Astro.props
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-mark">mobx<span>/</span>motion</a>
    </header>
    <slot />
    <footer class="site-footer">用 Astro、shiki-magic-move 與 MobX 打造</footer>
  </body>
</html>
