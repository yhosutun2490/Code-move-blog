---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('mobx', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  )

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1], total: posts.length },
  }))
}

interface Props {
  post: CollectionEntry<'mobx'>
  prev?: CollectionEntry<'mobx'>
  next?: CollectionEntry<'mobx'>
  total: number
}

const { post, prev, next, total } = Astro.props
const { Content } = await render(post)
---

<BaseLayout title={`${post.data.title} · mobx/motion`} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <p class="eyebrow">MobX 拆解 · 第 {post.data.order} 篇 / 共 {total} 篇</p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav" aria-label="系列導覽">
      {prev ? <a href={`/mobx/${prev.id}/`} class="prev">← {prev.data.title}</a> : <span />}
      {next ? <a href={`/mobx/${next.id}/`} class="next">{next.data.title} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>
