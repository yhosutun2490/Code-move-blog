---
// StarlightPage 必須是第一個 import（Starlight 依此決定 CSS layer 順序）
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { publishedSeriesPosts } from '../lib/series'

// 系列封面：eyebrow、標題與導言由 PageTitle 依 frontmatter 畫（和文章頁的標題區同一套），
// 這裡只負責篇章列表。依篇章順序，不含草稿。
const posts = await publishedSeriesPosts()

// StarlightPage 會用 docs 集合的 schema 驗證 frontmatter，所以 description、order 都要給。
// description 就是封面導言，也是 <meta name="description">。
const frontmatter = {
  title: '把 MobX 拆開來看',
  description:
    '從最基本的 getter / setter 開始，一步一步疊出依賴追蹤、computed、action 與 observer。每篇都有程式碼動畫和可以直接玩的 demo。',
  order: 0, // 只為了通過 schema（order 必填），首頁不在側欄裡，這個值不會被用到
  // 用一般文章版型（不用 splash），只關掉本頁目錄；側欄由下面的 hasSidebar 關掉。
  // 封面只有一欄：標題、導言、篇章列表，篇章列表本身就是導覽。
  tableOfContents: false as const,
}
---

<StarlightPage frontmatter={frontmatter} hasSidebar={false}>
  <ol class="series not-content">
    {
      posts.map((post) => (
        <li>
          <a href={`/${post.id}/`}>
            <span class="series-num">{String(post.data.order).padStart(2, '0')}</span>
            <span class="series-body">
              <span class="series-title">{post.data.title}</span>
              <span class="series-desc">{post.data.description}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</StarlightPage>
