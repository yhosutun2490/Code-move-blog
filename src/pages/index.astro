---
// StarlightPage 必須是第一個 import（Starlight 依此決定 CSS layer 順序）
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { getCollection } from 'astro:content'

const posts = (
  await getCollection('docs', ({ id, data }) => id.startsWith('mobx/') && !data.draft)
).sort((a, b) => a.data.order - b.data.order)

// StarlightPage 會用 docs 集合的 schema 驗證 frontmatter，所以 description、order 都要給
const frontmatter = {
  title: '把 MobX 拆開來看',
  description: 'MobX 拆解筆記：從 getter/setter 一路到 observer',
  order: 0,
  template: 'splash' as const,
}
---

<StarlightPage frontmatter={frontmatter}>
  <div class="home not-content">
    <p class="lede">
      從最基本的 getter / setter 開始，一步一步疊出依賴追蹤、computed、action 與 observer。
      每篇都有程式碼動畫和可以直接玩的 demo。
    </p>

    <ol class="series">
      {
        posts.map((post) => (
          <li>
            <a href={`/${post.id}/`}>
              <span class="series-num">{String(post.data.order).padStart(2, '0')}</span>
              <span class="series-body">
                <span class="series-title">{post.data.title}</span>
                <span class="series-desc">{post.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</StarlightPage>
