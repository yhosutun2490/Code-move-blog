---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const posts = (
  await getCollection('docs', ({ id, data }) => id.startsWith('mobx/') && !data.draft)
).sort((a, b) => a.data.order - b.data.order)
---

<BaseLayout title="mobx/motion · MobX 拆解筆記">
  <main class="home">
    <p class="eyebrow">自我學習系列</p>
    <h1>把 MobX 拆開來看</h1>
    <p class="lede">
      從最基本的 getter / setter 開始，一步一步疊出依賴追蹤、computed、action 與 observer。
      每篇都有程式碼動畫和可以直接玩的 demo。
    </p>

    <ol class="series">
      {
        posts.map((post) => (
          <li>
            <a href={`/${post.id}/`}>
              <span class="series-num">{String(post.data.order).padStart(2, '0')}</span>
              <span class="series-body">
                <span class="series-title">{post.data.title}</span>
                <span class="series-desc">{post.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
