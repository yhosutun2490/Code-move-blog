---
// StarlightPage 必須是第一個 import（Starlight 依此決定 CSS layer 順序）
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { formatPostDate, latestPost, publishedTopics, topicOfPost } from '../lib/series'
import { siteConfig } from '../lib/site-config'

// 網站封面：eyebrow、標題與導言由 PageTitle 依 frontmatter 畫（和文章頁的標題區同一套）。
// 這裡畫封面下方的兩塊：「最新一篇」（發佈日期最晚的篇章 + 同主題的篇章編號列）與「所有主題」索引。
// 和側欄同一個來源：只列有已發布文章的主題，依主題 order；組內依篇章 order，不含草稿。
const groups = await publishedTopics()
const latest = await latestPost()
const latestGroup = latest && groups.find((g) => g.topic.slug === topicOfPost(latest.id))!

// StarlightPage 會用 docs 集合的 schema 驗證 frontmatter，所以 description、order 都要給。
// 封面標題與導言來自網站設定；description 就是封面導言，也是 <meta name="description">。
const frontmatter = {
  title: siteConfig.cover.title,
  description: siteConfig.cover.lede,
  order: 0, // 只為了通過 schema（order 必填），首頁不在側欄裡，這個值不會被用到
  // 用一般文章版型（不用 splash）：左側是和文章頁相同的側欄，只關掉本頁目錄
  tableOfContents: false as const,
}
---

<StarlightPage frontmatter={frontmatter}>
  <div class="not-content">
    {
      latest && latestGroup && (
        <section class="home-latest" aria-labelledby="home-latest">
          <h2 id="home-latest" class="home-head">
            最新一篇
          </h2>
          <a class="latest" href={`/${latest.id}/`}>
            <span class="latest-meta">
              {latestGroup.topic.name} · 第 {latest.data.order} 篇 ·{' '}
              <time datetime={formatPostDate(latest.data.date!)}>{formatPostDate(latest.data.date!)}</time>
            </span>
            <span class="latest-title">{latest.data.title}</span>
            <span class="latest-desc">{latest.data.description}</span>
            <span class="latest-cta">開始閱讀 →</span>
          </a>
          {/* 同主題的篇章編號列：編號看不出是哪篇，完整名稱放在 aria-label 與 title */}
          <ol class="series-dots" aria-label={`${latestGroup.topic.name}的篇章`}>
            {latestGroup.posts.map((post) => (
              <li>
                <a
                  href={`/${post.id}/`}
                  aria-label={`第 ${post.data.order} 篇：${post.data.title}`}
                  title={post.data.title}
                  aria-current={post.id === latest.id ? 'true' : undefined}
                >
                  {String(post.data.order).padStart(2, '0')}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="home-topics" aria-labelledby="home-topics">
      <h2 id="home-topics" class="home-head">所有主題</h2>
      <ul class="topic-index">
        {
          groups.map(({ topic, posts }) => (
            <li>
              <a href={`/${posts[0].id}/`}>
                <span class="topic-index-name">{topic.name}</span>
                <span class="topic-index-desc">{topic.description}</span>
                <span class="topic-index-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</StarlightPage>
